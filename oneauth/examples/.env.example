# ============================================================================
#  .env — Environment variables for oneauth
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ============================================================================

# ── Required ─────────────────────────────────────────────────────────────────

# JWT signing secret (32+ chars, random). Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# MongoDB connection string
MONGO_URL=mongodb://localhost:27017/myapp

# ── Google OAuth / Social Login (Optional) ──────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── App URLs ─────────────────────────────────────────────────────────────────

# Public URL of this API server
APP_URL=http://localhost:3000

# Frontend URL (for email links, CORS)
FRONTEND_URL=http://localhost:5173

# App name (used in emails)
APP_NAME=MyApp

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Email (required in production) ───────────────────────────────────────────
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# ── Seed Admin (optional, runs on first startup) ────────────────────────────
# ADMIN_EMAIL=admin@myapp.com
# ADMIN_PASSWORD=change-me-immediately-1234
